rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Jeder eingeloggte Nutzer darf ausschliesslich seinen eigenen verschluesselten Tresor lesen & schreiben
    match /vaults/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
